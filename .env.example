# Mistral (chat, transcription)
MISTRAL_API_KEY=

# Supabase (sign-in and data). Local: run `pnpm exec supabase start`, then copy API_URL and
# PUBLISHABLE_KEY from `pnpm exec supabase status`. Both are safe in the browser; every query
# runs as the signed-in user, so Postgres RLS decides what they can see.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local dev account with sample data (supabase/seed.sql): sign in as owner@local.test and read
# the code in Mailpit at http://127.0.0.1:54324
